+++ b/packages/os/rugix/recipes/setup-green/files/boot.cmd
@@ -0,0 +1,10 @@
+# Experimental Green U-Boot to EFI handoff; no persistent firmware writes.
+if test -z "${distro_bootpart}"; then
+    setenv distro_bootpart 1
+fi
+if load ${devtype} ${devnum}:${distro_bootpart} ${fdt_addr_r} rockchip/rk3566-ha-green.dtb; then
+    if load ${devtype} ${devnum}:${distro_bootpart} ${kernel_addr_r} EFI/BOOT/BOOTAA64.efi; then
+        bootefi ${kernel_addr_r} ${fdt_addr_r}
+    fi
+fi
+echo "Green EFI handoff failed"
