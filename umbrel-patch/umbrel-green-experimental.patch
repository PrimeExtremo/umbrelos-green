diff --git a/scripts/experimental-green/build-green-dtb.sh b/scripts/experimental-green/build-green-dtb.sh
new file mode 100755
index 0000000..6d3bb16
--- /dev/null
+++ b/scripts/experimental-green/build-green-dtb.sh
@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd /opt/green-firmware
+curl -fL --retry 3 https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.12.96.tar.xz -o linux-6.12.96.tar.xz
+tar -xf linux-6.12.96.tar.xz
+cd linux-6.12.96
+# Only import board device-tree changes; this is not a replacement kernel build.
+for patch_file in /opt/haos/buildroot-external/board/nabucasa/green/patches/linux/*.patch; do
+    git apply --include='arch/arm64/boot/dts/rockchip/rk3566-ha-green.dts' "$patch_file"
+done
+export ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu-
+make defconfig
+make -j8 rockchip/rk3566-ha-green.dtb
+cp arch/arm64/boot/dts/rockchip/rk3566-ha-green.dtb /opt/green-firmware/artifacts/
+sha256sum /opt/green-firmware/artifacts/rk3566-ha-green.dtb
diff --git a/scripts/experimental-green/build-green-uboot.sh b/scripts/experimental-green/build-green-uboot.sh
new file mode 100755
index 0000000..48d9521
--- /dev/null
+++ b/scripts/experimental-green/build-green-uboot.sh
@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+# Experimental removable-media firmware only. Does not flash any device.
+set -euo pipefail
+export DEBIAN_FRONTEND=noninteractive
+apt-get update
+apt-get install -y --no-install-recommends build-essential gcc-aarch64-linux-gnu bison flex libssl-dev libgnutls28-dev python3-dev python3-setuptools python3-pyelftools python3-pycryptodome device-tree-compiler swig bc xz-utils curl
+task_dir=/opt/green-firmware
+mkdir -p "$task_dir"
+cd "$task_dir"
+haos_revision=00ade1a907f1bf405c7af819eccf46006b764f78
+[[ $(git -C /opt/haos rev-parse HEAD) == "$haos_revision" ]]
+curl -fL --retry 3 https://ftp.denx.de/pub/u-boot/u-boot-2026.04.tar.bz2 -o u-boot-2026.04.tar.bz2
+tar -xf u-boot-2026.04.tar.bz2
+cd u-boot-2026.04
+for patch_file in /opt/haos/buildroot-external/board/nabucasa/green/patches/uboot/*.patch; do
+    patch -p1 < "$patch_file"
+done
+cd "$task_dir"
+git clone --filter=blob:none --no-checkout https://github.com/rockchip-linux/rkbin.git
+git -C rkbin sparse-checkout init --no-cone
+git -C rkbin sparse-checkout set '/bin/rk35/rk3568_bl31_v1.43.elf' '/bin/rk35/rk3566_ddr_1056MHz_v1.18.bin' '/LICENSE*'
+git -C rkbin checkout b4558da0860ca48bf1a571dd33ccba580b9abe23
+cd u-boot-2026.04
+export ARCH=arm CROSS_COMPILE=aarch64-linux-gnu-
+make green_defconfig
+# Unlike HAOS, the Umbrel generic ARM64 baseline requires an EFI loader.
+scripts/config --enable DISTRO_DEFAULTS --enable EFI_LOADER --enable CMD_BOOTEFI --enable CMD_BOOTEFI_BOOTMGR --enable CMD_EXT4 --enable CMD_FAT --enable CMD_USB --enable CMD_SETEXPR --set-val BOOTDELAY 3
+scripts/config --set-str BOOTCOMMAND 'setenv boot_targets mmc0 mmc1 usb; bootflow scan -lb'
+make olddefconfig
+grep -q '^CONFIG_EFI_LOADER=y$' .config
+make -j8 BL31="$task_dir/rkbin/bin/rk35/rk3568_bl31_v1.43.elf" ROCKCHIP_TPL="$task_dir/rkbin/bin/rk35/rk3566_ddr_1056MHz_v1.18.bin"
+mkdir -p "$task_dir/artifacts"
+cp u-boot-rockchip.bin .config "$task_dir/artifacts/"
+sha256sum "$task_dir/artifacts/u-boot-rockchip.bin" > "$task_dir/artifacts/SHA256SUMS"
+echo 'Firmware compiled; hardware boot and disk layout are unverified. Do not flash it standalone.'
