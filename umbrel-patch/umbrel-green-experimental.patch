@@ -0,0 +1,10 @@
+#!/bin/bash
+set -euo pipefail
+mkdir -p "${RUGIX_LAYER_DIR}/firmware" "${RUGIX_LAYER_DIR}/roots/config/rockchip"
+install -m 644 "${RECIPE_DIR}/files/u-boot-rockchip.bin" "${RUGIX_LAYER_DIR}/firmware/"
+install -m 644 "${RECIPE_DIR}/files/rk3566-ha-green.dtb" "${RUGIX_LAYER_DIR}/roots/config/rockchip/"
+install -m 644 "${RECIPE_DIR}/files/boot.scr" "${RUGIX_LAYER_DIR}/roots/config/"
+# Green UART2 runs at 1.5 Mbaud. Keep local console output too.
+sed -i 's/console=ttyS0 console=tty1/console=ttyS2,1500000n8 console=tty0/' "${RUGIX_LAYER_DIR}/roots/boot/grub.cfg"
+mkdir -p /etc/umbrel-green
+echo 'Experimental Green port; hardware validation pending' > /etc/umbrel-green/status
